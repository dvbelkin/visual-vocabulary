{
    "name": "visual-vocabulary",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "npm run legacy:check && astro check && astro build && npm run performance:check && npm run test:routes",
        "preview": "astro preview",
        "check": "astro check",
        "lint": "eslint src scripts tests astro.config.mjs eslint.config.mjs --max-warnings=0",
        "legacy:check": "node scripts/check-legacy-d3.mjs",
        "performance:check": "node scripts/check-performance.mjs",
        "test": "npm run legacy:check && vitest run tests/contracts.test.ts",
        "test:routes": "node --test tests/routes.test.mjs",
        "format": "prettier --write \"src/**/*.{astro,css,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.{mjs,ts}\" package.json tsconfig.json astro.config.mjs eslint.config.mjs .prettierrc.mjs AGENTS.md PLAN.md",
        "format:check": "prettier --check \"src/**/*.{astro,css,ts}\" \"scripts/**/*.mjs\" \"tests/**/*.{mjs,ts}\" package.json tsconfig.json astro.config.mjs eslint.config.mjs .prettierrc.mjs AGENTS.md PLAN.md"
    },
    "dependencies": {
        "@deck.gl/aggregation-layers": "^9.3.7",
        "@deck.gl/core": "^9.3.7",
        "@deck.gl/geo-layers": "^9.3.7",
        "@deck.gl/layers": "^9.3.7",
        "astro": "^7.1.3",
        "d3-contour": "^4.0.2",
        "d3-delaunay": "^6.0.4",
        "d3-force": "^3.0.0",
        "d3-geo": "^3.1.1",
        "d3-scale": "^4.0.2",
        "d3-scale-chromatic": "^3.1.0",
        "echarts": "^6.1.0",
        "maplibre-gl": "^6.0.0",
        "topojson-client": "^3.1.0"
    },
    "devDependencies": {
        "@astrojs/check": "latest",
        "@eslint/js": "^10.0.1",
        "@types/d3-contour": "^3.0.6",
        "@types/d3-delaunay": "^6.0.4",
        "@types/d3-force": "^3.0.10",
        "@types/d3-geo": "^3.1.0",
        "@types/d3-scale": "^4.0.9",
        "@types/d3-scale-chromatic": "^3.1.0",
        "@types/topojson-client": "^3.1.5",
        "eslint": "^10.8.0",
        "eslint-plugin-astro": "^3.0.1",
        "globals": "^17.7.0",
        "prettier": "latest",
        "prettier-plugin-astro": "latest",
        "typescript": "latest",
        "typescript-eslint": "^8.65.0",
        "vitest": "^4.1.10"
    }
}
