---
import ChartCard from "../../components/catalog/ChartCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { categoryNames, charts } from "../../lib/catalog";
import { isLocale, locales, t, type Locale } from "../../lib/i18n";

export function getStaticPaths() {
    return locales.map((locale) => ({ params: { locale } }));
}

const localeParam = Astro.params.locale;
if (!isLocale(localeParam)) {
    throw new Error(`Unsupported locale: ${localeParam}`);
}
const locale: Locale = localeParam;
const copy = t(locale);
const visibleCategories = [...new Set(charts.map((chart) => chart.category))];
---

<BaseLayout locale={locale}>
    <section class="hero container">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.title}</h1>
        <p class="hero__lead">{copy.lead}</p>
        <div class="hero__motif" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span>
        </div>
    </section>

    <section class="catalog container" aria-labelledby="catalog-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">ECharts · Astro</p>
                <h2 id="catalog-title">{copy.catalogTitle}</h2>
            </div>
            <p>{copy.catalogLead}</p>
        </div>
        <dl class="migration-progress" aria-label={copy.progressLabel}>
            <div>
                <dt>{copy.progressLabel}</dt>
                <dd>
                    <strong>{charts.length}</strong>
                    <span>/ {charts.length}</span>
                </dd>
            </div>
        </dl>
        <form class="catalog-search" role="search" data-catalog-search>
            <label for="catalog-query">{copy.searchLabel}</label>
            <input
                id="catalog-query"
                type="search"
                name="query"
                placeholder={copy.searchPlaceholder}
                autocomplete="off"
                data-catalog-query
            />
            <p class="catalog-search__status" aria-live="polite" data-search-status>
                {copy.searchResults}: {charts.length}
            </p>
        </form>
        <div
            class="category-filters"
            role="group"
            aria-label={copy.categoryFilter}
            data-category-filters
        >
            <button type="button" class="is-active" data-category-filter="all" aria-pressed="true">
                {copy.allCategories}
            </button>
            {
                visibleCategories.map((category) => (
                    <button type="button" data-category-filter={category} aria-pressed="false">
                        {categoryNames[category][locale]}
                    </button>
                ))
            }
        </div>
        <div class="chart-grid" data-chart-grid>
            {
                charts.map((chart, index) => (
                    <ChartCard chart={chart} locale={locale} index={index} />
                ))
            }
        </div>
        <p class="catalog-empty" data-catalog-empty hidden>{copy.noResults}</p>
    </section>
</BaseLayout>

<script>
    const search = document.querySelector<HTMLElement>("[data-catalog-search]");
    const query = search?.querySelector<HTMLInputElement>("[data-catalog-query]");
    const status = search?.querySelector<HTMLElement>("[data-search-status]");
    const grid = document.querySelector<HTMLElement>("[data-chart-grid]");
    const empty = document.querySelector<HTMLElement>("[data-catalog-empty]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-chart-card]")];
    const categoryButtons = [
        ...document.querySelectorAll<HTMLButtonElement>("[data-category-filter]"),
    ];
    let activeCategory = "all";

    if (search && query && status && grid && empty) {
        const label = status.textContent?.split(":")[0]?.trim() ?? "";
        const filter = () => {
            const value = query.value.trim().toLocaleLowerCase(document.documentElement.lang);
            let visible = 0;

            cards.forEach((card) => {
                const matchesSearch = !value || card.dataset.searchText?.includes(value);
                const matchesCategory =
                    activeCategory === "all" || card.dataset.chartCategory === activeCategory;
                const matches = matchesSearch && matchesCategory;
                card.hidden = !matches;
                if (matches) visible += 1;
            });

            status.textContent = `${label}: ${visible}`;
            empty.hidden = visible > 0;
            grid.hidden = visible === 0;
        };

        query.addEventListener("input", filter);
        search.addEventListener("reset", () => requestAnimationFrame(filter));
        categoryButtons.forEach((button) => {
            button.addEventListener("click", () => {
                activeCategory = button.dataset.categoryFilter ?? "all";
                categoryButtons.forEach((candidate) => {
                    const active = candidate === button;
                    candidate.classList.toggle("is-active", active);
                    candidate.setAttribute("aria-pressed", String(active));
                });
                filter();
            });
        });
    }
</script>
