---
import EChart from "../../../components/charts/EChart.astro";
import D3Map from "../../../components/charts/D3Map.astro";
import DeckMap from "../../../components/charts/DeckMap.astro";
import MapLibreMap from "../../../components/charts/MapLibreMap.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { categoryNames, charts } from "../../../lib/catalog";
import { locales, localePath, t, type Locale } from "../../../lib/i18n";

export function getStaticPaths() {
    return locales.flatMap((locale) =>
        charts.map((chart) => ({
            params: { locale, id: chart.id },
            props: { chart, locale },
        })),
    );
}

const { chart, locale } = Astro.props;
const copy = t(locale as Locale);
const activeLocale = locale as Locale;
const rows = chart.data.map((row) => ({
    label: row.label[activeLocale],
    value: row.value,
    value2: row.value2,
    value3: row.value3,
}));
const usesD3Map = chart.id === "basic-choropleth" || chart.id === "scaled-cartogram-value";
const usesMapLibre = ["proportional-symbol", "dot-density", "heat-map"].includes(chart.id);
const usesDeck = ["flow", "contour", "equalised-cartogram"].includes(chart.id);
---

<BaseLayout
    locale={activeLocale}
    title={chart.title[activeLocale]}
    description={chart.description[activeLocale]}
    alternatePath={`charts/${chart.id}`}
>
    <article class="chart-page container">
        <a class="back-link" href={localePath(activeLocale)}>
            <span aria-hidden="true">←</span>
            {copy.back}
        </a>
        <header class="chart-page__header">
            <div>
                <p class="eyebrow">
                    {copy.category}: {categoryNames[chart.category][activeLocale]}
                </p>
                <h1>{chart.title[activeLocale]}</h1>
            </div>
            <p id="chart-description">{chart.description[activeLocale]}</p>
        </header>

        <section class="chart-stage" aria-labelledby="chart-title">
            <div class="chart-stage__heading">
                <div>
                    <p class="eyebrow">
                        {chart.dataStatus?.[activeLocale] ?? copy.synthetic}
                    </p>
                    <h2 id="chart-title">{chart.title[activeLocale]}</h2>
                </div>
                <span class="unit">{chart.unit[activeLocale]}</span>
            </div>
            {
                usesD3Map ? (
                    <D3Map
                        chart={chart}
                        locale={activeLocale}
                        label={copy.chartLabel}
                        descriptionId="chart-description"
                    />
                ) : usesMapLibre ? (
                    <MapLibreMap
                        chart={chart}
                        locale={activeLocale}
                        label={copy.chartLabel}
                        descriptionId="chart-description"
                    />
                ) : usesDeck ? (
                    <DeckMap
                        chart={chart}
                        locale={activeLocale}
                        label={copy.chartLabel}
                        descriptionId="chart-description"
                    />
                ) : (
                    <EChart
                        chart={chart}
                        locale={activeLocale}
                        label={copy.chartLabel}
                        descriptionId="chart-description"
                    />
                )
            }
            {
                chart.source && (
                    <p class="chart-source">
                        {activeLocale === "ru" ? "Источник:" : "Source:"}{" "}
                        <a href={chart.source.url}>{chart.source.label[activeLocale]}</a>
                    </p>
                )
            }
        </section>

        <div class="learning-grid">
            <section>
                <p class="learning-grid__marker" aria-hidden="true">✓</p>
                <h2>{copy.whenToUse}</h2>
                <p>{chart.useWhen[activeLocale]}</p>
            </section>
            <section>
                <p class="learning-grid__marker learning-grid__marker--avoid" aria-hidden="true">
                    ×
                </p>
                <h2>{copy.avoidWhen}</h2>
                <p>{chart.avoidWhen[activeLocale]}</p>
            </section>
        </div>

        <section class="data-table" aria-labelledby="data-title">
            <div class="section-heading section-heading--compact">
                <div>
                    <p class="eyebrow">
                        {chart.dataStatus?.[activeLocale] ?? copy.synthetic}
                    </p>
                    <h2 id="data-title">{copy.dataTitle}</h2>
                </div>
            </div>
            <details class="data-details">
                <summary>{copy.showData}</summary>
                <div class="table-scroll">
                    <table>
                        <thead>
                            <tr>
                                <th scope="col">{copy.observation}</th>
                                <th scope="col">
                                    {chart.valueLabels?.primary[activeLocale] ?? copy.value}
                                </th>
                                {
                                    rows.some((row) => row.value2 !== undefined) && (
                                        <th scope="col">
                                            {chart.valueLabels?.secondary?.[activeLocale] ??
                                                copy.secondValue}
                                        </th>
                                    )
                                }
                                {
                                    rows.some((row) => row.value3 !== undefined) && (
                                        <th scope="col">
                                            {chart.valueLabels?.tertiary?.[activeLocale] ??
                                                copy.thirdValue}
                                        </th>
                                    )
                                }
                            </tr>
                        </thead>
                        <tbody>
                            {
                                rows.map((row) => (
                                    <tr>
                                        <th scope="row">{row.label.replace("|", " · ")}</th>
                                        <td>{row.value.toLocaleString(activeLocale)}</td>
                                        {rows.some((item) => item.value2 !== undefined) && (
                                            <td>
                                                {row.value2?.toLocaleString(activeLocale) ?? "—"}
                                            </td>
                                        )}
                                        {rows.some((item) => item.value3 !== undefined) && (
                                            <td>
                                                {row.value3?.toLocaleString(activeLocale) ?? "—"}
                                            </td>
                                        )}
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        </section>
    </article>
</BaseLayout>
