---
import type { ChartDefinition } from "../../lib/catalog";
import type { Locale } from "../../lib/i18n";

interface Props {
    chart: ChartDefinition;
    locale: Locale;
    label: string;
    descriptionId: string;
}

const { chart, locale, label, descriptionId } = Astro.props;
const payload = {
    kind: chart.kind,
    title: chart.title[locale],
    unit: chart.unit[locale],
    locale,
    data: chart.data.map((row) => ({
        label: row.label[locale],
        key: row.key,
        value: row.value,
        value2: row.value2,
        value3: row.value3,
        values: row.values,
    })),
};
---

<div
    class="chart-shell"
    data-echart-root
    data-chart-kind={chart.kind}
    role="img"
    aria-label={`${label}: ${chart.title[locale]}`}
    aria-describedby={descriptionId}
>
    <div class="chart-canvas"></div>
    <script
        type="application/json"
        data-echart-payload
        is:inline
        set:html={JSON.stringify(payload)}
    />
</div>

<script>
    import { init, use } from "echarts/core";
    import { BarChart, HeatmapChart, LineChart, ScatterChart } from "echarts/charts";
    import {
        AriaComponent,
        CalendarComponent,
        GridComponent,
        LegendComponent,
        ParallelComponent,
        RadarComponent,
        TitleComponent,
        TooltipComponent,
        VisualMapComponent,
    } from "echarts/components";
    import { CanvasRenderer } from "echarts/renderers";
    import { buildChartOption, type ChartPayload } from "../../lib/charts/options";
    import { mountChart } from "../../lib/charts/lifecycle";

    use([
        AriaComponent,
        BarChart,
        CalendarComponent,
        CanvasRenderer,
        GridComponent,
        HeatmapChart,
        LegendComponent,
        LineChart,
        ParallelComponent,
        RadarComponent,
        ScatterChart,
        TitleComponent,
        TooltipComponent,
        VisualMapComponent,
    ]);

    const cleanups: Array<() => void> = [];
    const mapKinds = new Set([
        "choropleth-map",
        "symbol-map",
        "flow-map",
        "contour-map",
        "tile-cartogram",
        "dorling-cartogram",
        "dot-density-map",
        "spatial-heatmap",
    ]);
    const basicKinds = new Set([
        "bar",
        "line",
        "scatter",
        "histogram",
        "heatmap",
        "diverging-bar",
        "grouped-bar",
        "lollipop",
        "rank-change",
        "bullet",
        "timeline-bar",
        "combo",
        "slope",
        "stacked-area",
        "calendar",
        "population-pyramid",
        "dot-range",
        "cumulative",
        "observation-strip",
        "barcode",
        "stacked-bar",
        "normalized-stacked",
        "waterfall",
        "diverging-stacked",
        "vertical-bar",
        "proportional-symbols",
        "dot-strip",
        "vertical-lollipop",
        "bump",
        "correlation-combo",
        "connected-scatter",
        "bubble",
        "process-waterfall",
        "grouped-column",
        "fan",
        "timeline-connected",
        "circle-timeline",
        "seismogram",
        "symbol-grid",
    ]);

    document.querySelectorAll<HTMLElement>("[data-echart-root]").forEach(async (root) => {
        if (root.dataset.initialized) return;

        const canvas = root.querySelector<HTMLElement>(".chart-canvas");
        const source = root.querySelector<HTMLScriptElement>("[data-echart-payload]");
        if (!canvas || !source?.textContent) return;

        root.dataset.initialized = "true";
        const payload = JSON.parse(source.textContent) as Omit<ChartPayload, "reducedMotion">;
        let createChartOption = buildChartOption;
        if (mapKinds.has(payload.kind)) {
            const mapModule = await import("../../lib/charts/map-options");
            mapModule.registerMapCharts();
            createChartOption = mapModule.buildMapOption;
        } else if (!basicKinds.has(payload.kind)) {
            const { registerSpecializedCharts } =
                await import("../../lib/charts/register-specialized");
            registerSpecializedCharts();
        }
        const media = window.matchMedia("(prefers-reduced-motion: reduce)");
        const chart = init(canvas, undefined, { renderer: "canvas" });
        cleanups.push(
            mountChart({
                root,
                chart,
                payload,
                motionPreference: media,
                createOption: (currentPayload, reducedMotion) =>
                    createChartOption({ ...currentPayload, reducedMotion }),
                createResizeObserver: (callback) => new ResizeObserver(callback),
            }),
        );
    });

    document.addEventListener(
        "astro:before-swap",
        () => {
            cleanups.splice(0).forEach((cleanup) => cleanup());
        },
        { once: true },
    );
</script>

<style>
    .chart-shell {
        width: 100%;
        min-height: 420px;
    }

    .chart-canvas {
        width: 100%;
        height: 420px;
    }

    .chart-shell[data-chart-kind="violin"],
    .chart-shell[data-chart-kind="violin"] .chart-canvas {
        min-height: 720px;
        height: 720px;
    }

    @media (max-width: 600px) {
        .chart-shell,
        .chart-canvas {
            min-height: 340px;
            height: 340px;
        }

        .chart-shell[data-chart-kind="violin"],
        .chart-shell[data-chart-kind="violin"] .chart-canvas {
            min-height: 760px;
            height: 760px;
        }
    }
</style>
